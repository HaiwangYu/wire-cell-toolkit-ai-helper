# Long single muons for the YZ-map test (ai-helper issue 46): 5 GeV mu-,
# starting at z = -5 cm, x uniform over both TPCs, y uniform in +-120 cm,
# going along +z, uniform +-20 deg in the YZ plane and +-3 deg in XZ.
#include "prodsingle_sbnd_proj.fcl"
physics.producers.generator.PDG: [13]
physics.producers.generator.P0: [5]
physics.producers.generator.SigmaP: [0]
physics.producers.generator.PDist: 0
physics.producers.generator.X0: [0]
physics.producers.generator.SigmaX: [180]
physics.producers.generator.Y0: [0]
physics.producers.generator.SigmaY: [120]
physics.producers.generator.Z0: [-5]
physics.producers.generator.SigmaZ: [0]
physics.producers.generator.T0: [0]
physics.producers.generator.SigmaT: [0]
physics.producers.generator.PosDist: 0
physics.producers.generator.Theta0XZ: [0]
physics.producers.generator.SigmaThetaXZ: [3]
physics.producers.generator.Theta0YZ: [0]
physics.producers.generator.SigmaThetaYZ: [20]
physics.producers.generator.AngleDist: 0
