#!/bin/bash
#PBS -N wct-aurora-probe
#PBS -A neutrinoGPU::debug2
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -l filesystems=flare:home
#PBS -j oe
#PBS -o /lus/flare/projects/neutrinoGPU/yuhw/aurora-build-logs/probe-aurora.out
# Phase A1 probe for issue 29 (plan v2, section 3).  Answers Q2 (compute-node mechanics),
# Q3 (Recipe A' via twester's Flare UPS tree vs Recipe B via cvmfsexec) and the product
# list of the Gen2 reco1 (Q4).  Everything it needs is already on Flare (A0 done 2026-09-16):
#   $Y/cvmfsexec (dist built with makedist -m rhel8-x86_64 osg, default.local = proxy + /tmp cache)
#   /lus/flare/projects/neutrinoGPU/containers/slf7.sif, .../scisoft/larsoft (sbndcode v10_14_02_03)
# Submit from a UAN:  cd $Y/aurora-build-logs && qsub $S/probe-aurora.pbs
set -u
Y=/lus/flare/projects/neutrinoGPU/yuhw
P=/lus/flare/projects/neutrinoGPU
export HTTP_PROXY=http://proxy.alcf.anl.gov:3128 HTTPS_PROXY=http://proxy.alcf.anl.gov:3128 http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
export no_proxy="admin,*.hostmgmt.cm.aurora.alcf.anl.gov,*.alcf.anl.gov,localhost"
unset LD_PRELOAD
RECO1=$P/twester/sbnd_gen2_prod1/Gen2_2026/reco1/000000/000000/reco1-detsim-g4-gen-Gen2_2026-00d8-4843-8a75-5672.root   # 472 MB, MC, run 301
NCSB=$Y/sbnd-gen2-data/nc-sideband-lynn/filtered-reco1/nc-sideband_filtered_frameshift.root   # only if already transferred
echo "=== START $(date) on $(hostname) job ${PBS_JOBID%%.*}"

echo "=== node"; head -3 /etc/os-release; uname -r; nproc; lscpu | grep -E "Model name|^CPU\(s\)|Thread|Core|Socket|NUMA node\(s\)"; free -g | head -2
echo "=== cpuset / reserved cores"; cat /sys/fs/cgroup/cpuset.cpus.effective 2>/dev/null; taskset -cp $$
echo "=== other users on this node (debug is documented non-exclusive)"; ps -eo user= | sort | uniq -c | sort -rn | head -5
echo "=== filesystems"; df -h /lus/flare /home /tmp /dev/shm 2>&1; df -h /lus/eagle /local/scratch 2>&1 | tail -n +2; mount | grep -E " /tmp | /lus/| /local" | cut -c1-140; ls -d /lus/* 2>/dev/null
echo "=== cgroup limits"; C=$(sed -n 's/^0:://p' /proc/self/cgroup); echo "cgroup=$C"; for f in cpu.max memory.max pids.max; do echo "$f: $(cat /sys/fs/cgroup$C/$f 2>/dev/null)"; done
echo "=== userns / fuse"; echo "max_user_namespaces=$(cat /proc/sys/user/max_user_namespaces)"; unshare -U -r true && echo "unshare -U -r ok" || echo "unshare -U -r FAILED"; ls -l /dev/fuse 2>&1; which fusermount3 fusermount 2>&1 | head -2
echo "=== network (direct, then proxy)"; for u in https://github.com http://cvmfs-s1fnal.opensciencegrid.org:8000/cvmfs/sbnd.opensciencegrid.org/.cvmfspublished https://scisoft.fnal.gov/ https://registry-1.docker.io/v2/; do printf "%-95s " "$u"; env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY timeout 8 curl -sI "$u" 2>&1 | head -1 | tr -d '\r'; echo -n " | proxy: "; timeout 15 curl -sI "$u" 2>&1 | head -1 | tr -d '\r'; echo; done

echo "=== apptainer"
module load apptainer; module load fuse-overlayfs   # NOT piped: a pipe runs the module function in a subshell and the PATH change is lost (probe 1, 2026-09-16)
which apptainer; apptainer --version; ls -l $(dirname $(readlink -f $(which apptainer)))/../libexec/apptainer/bin/ 2>/dev/null | grep -i starter
SIF=$P/containers/slf7.sif; echo "SIF=$SIF"; ls -l $SIF
for m in "" "--fakeroot" "--userns"; do printf -- "-- mode '%s': " "$m"; timeout 120 apptainer exec $m -B /lus/flare $SIF cat /etc/redhat-release 2>&1 | tail -1; done

echo "=== Recipe A': twester's Flare UPS tree (sbndcode v10_14_02_03 -> larsoft v10_14_02_02)"
mkdir -p /tmp/larw-$USER && cd /tmp/larw-$USER
( time timeout 900 apptainer exec -B /lus/flare -B /tmp $SIF bash -c "
  source $P/scisoft/larsoft/setup
  echo PRODUCTS=\$PRODUCTS
  ups list -aK+ sbndcode | grep -c v10_14_02_03; for p in spdlog fmt patchelf scn; do echo \"\$p: \$(ups list -aK+ \$p 2>/dev/null | tr -d '\"' | awk '{print \$2, \$4}' | sort -u | tr '\n' ' ')\"; done
  time setup sbndcode v10_14_02_03 -q e26:prof; echo setup_rc=\$?
  echo SBNDCODE_DIR=\$SBNDCODE_DIR; echo LARWIRECELL_DIR=\$LARWIRECELL_DIR; echo WIRECELL_DIR=\$WIRECELL_DIR; echo SPDLOG_DIR=\$SPDLOG_DIR
  which lar; time lar --version
  echo '--- eventdump of the Gen2 reco1 (products the img-clus-match-pr MC fcl needs)'
  time lar -c eventdump.fcl -s $RECO1 -n 1 > dump.log 2>&1; echo lar_rc=\$?
  grep -E 'Art has completed|status' dump.log | tail -1
  echo 'expected: recob::Wires simtpc2d dnnsp; simtpc2d wienersummary / badmasks; recob::OpFlashs opflashtpc0/opflashtpc1; sim::SimEnergyDeposits ionandscint priorSCE; simb::MCTruths; simb::MCParticles'
  grep -E 'recob::Wires|wienersummary|badmasks|OpFlash|SimEnergyDeposit|MCTruth|MCParticle|FrameShift' dump.log | grep -vE '^\s*$' | cut -c1-160 | sort -u | head -40
  echo '--- dev headers in slf7.sif? (wcb configure needs bzlib.h, zlib.h, etc.)'; ls /usr/include/bzlib.h /usr/include/zlib.h 2>&1; rpm -qa | grep -c devel
" ) 2>&1 | tail -70

echo "=== Recipe B: cvmfsexec through the proxy (private dist on /tmp), fnal-dev-sl7 from CVMFS"
L=/tmp/cvmfsexec-$USER; rsync -a --exclude .git --exclude 'dist/var/lib/cvmfs/*' --exclude 'log/*' $Y/cvmfsexec/ $L/ && sed -i "s|^CVMFS_CACHE_BASE=.*|CVMFS_CACHE_BASE=/tmp/cvmfs-cache-$USER|" $L/dist/etc/cvmfs/default.local && mkdir -p /tmp/cvmfs-cache-$USER
cd $L && ( time timeout 1200 ./cvmfsexec sbnd.opensciencegrid.org larsoft.opensciencegrid.org fermilab.opensciencegrid.org singularity.opensciencegrid.org uboone.opensciencegrid.org -- bash -c "
  ls /cvmfs/sbnd.opensciencegrid.org/products/sbnd/sbndcode/ | tail -2
  ls -d /cvmfs/uboone.opensciencegrid.org/products/scn/v01_00_00 /cvmfs/larsoft.opensciencegrid.org/products/spdlog/v1_14_1 /cvmfs/larsoft.opensciencegrid.org/products/fmt/v11_0_2 /cvmfs/larsoft.opensciencegrid.org/products/patchelf/0.13.1 2>&1
  time apptainer exec -B /cvmfs -B /lus/flare -B /tmp /cvmfs/singularity.opensciencegrid.org/fermilab/fnal-dev-sl7:latest bash -c '
    cat /etc/redhat-release; ls /usr/include/bzlib.h; source /cvmfs/sbnd.opensciencegrid.org/products/sbnd/setup_sbnd.sh >/dev/null 2>&1; setup sbndcode v10_14_02_03 -q e26:prof >/dev/null 2>&1; echo SBNDCODE_DIR=\$SBNDCODE_DIR; time lar --version'
" ) 2>&1 | grep -v -E "^ln: |CernVM-FS: (loading|mounted)" | tail -25
echo "=== cvmfs cache: $(du -sh /tmp/cvmfs-cache-$USER 2>/dev/null | cut -f1)"

echo "=== scn v01_00_00 (DL vertex venv) from uboone CVMFS -> \$Y/products/scn (one-time; skipped if present)"
if [ ! -d $Y/products/scn/v01_00_00 ]; then
  cd $L && ( time timeout 1500 ./cvmfsexec uboone.opensciencegrid.org larsoft.opensciencegrid.org -- bash -c "
    du -sh /cvmfs/uboone.opensciencegrid.org/products/scn/ 2>/dev/null | tail -1
    mkdir -p $Y/products/scn && rsync -a /cvmfs/uboone.opensciencegrid.org/products/scn/ $Y/products/scn/ && echo scn_rsync_ok
    ls /cvmfs/larsoft.opensciencegrid.org/products/patchelf/ 2>&1 | head -3
  " ) 2>&1 | grep -v -E "^ln: |CernVM-FS: (loading|mounted)" | tail -6
fi
ls $Y/products/scn/ 2>&1; du -sh $Y/products/scn 2>/dev/null | cut -f1
echo "=== Recipe A' with our overlay: setup-aurora-opt.sh inside the dev image (gcc 12.1, python 3.9, spdlog v1_14_1 expected)"
S=$Y/wire-cell-toolkit-ai-helper/issues/29-aurora-production/scripts
cd /tmp && SL7_SETUP=$S/setup-aurora-run.sh timeout 600 $S/in-aurora-sl7.sh bash -c 'which g++ python3 lar wcsonnet 2>&1; g++ --version | head -1; python3 --version; ups active | grep -E "^(sbndcode|larsoft|spdlog|fmt|cetmodules|cmake|gcc|python) " ; echo scn_on_pythonpath=$(echo $PYTHONPATH | tr : "\n" | grep -c scn); echo PRODUCTS=$PRODUCTS' 2>&1 | tail -20
[ -f "$NCSB" ] && { echo "=== nc-sideband file present: $(ls -l $NCSB | awk '{print $5}') bytes"; } || echo "=== nc-sideband file not yet on Flare (Globus, A0)"
echo "=== /tmp used: $(du -sh /tmp/larw-$USER /tmp/cvmfsexec-$USER /tmp/cvmfs-cache-$USER 2>/dev/null | cut -f1 | tr '\n' ' ')"
echo "=== END $(date)"
