#!/bin/bash
#PBS -N wct-run-sl7
#PBS -A neutrinoGPU::debug2
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=00:10:00
#PBS -l filesystems=flare:home
#PBS -j oe
#PBS -o /lus/flare/projects/neutrinoGPU/yuhw/aurora-build-logs/run-sl7.out
# Run one command inside the SL7 container with setup-aurora-opt.sh (ROOT etc.):
#   qsub -v "CMD=<command line>" run-sl7.pbs
set -u
Y=/lus/flare/projects/neutrinoGPU/yuhw; S=$Y/wire-cell-toolkit-ai-helper/issues/29-aurora-production/scripts; export Y
echo "=== START $(date) CMD=$CMD"
SL7_SETUP=$S/setup-aurora-opt.sh $S/in-aurora-sl7.sh bash -c "$CMD" 2>&1 | grep -v '^INFO'
echo "=== END $(date)"
