# Select ALL 25 events of BEE set 763d6e03-16c1-44a2-be59-23ffd78bd872 from the
# MCP2025C FallProduction CV reco1 sample and merge them into ONE artROOT file.
# Supersedes the 8-event "type2" subset (ai-helper issue 21).
#
# RSEs came from that set's truth_unlabeled layer -- every other layer reports
# run/subrun 0 because the set predates the RSE fix (issue 13 G3).
#
# filterruns[i] pairs with filterevts[i]; the module ignores subRun.  Verified
# safe here: all 25 (run, event) pairs are unique, even though four run/subrun
# pairs carry more than one selected event (105.23 x3, 651.84 / 890.21 / 921.29 x2).
#
#   lar -c filter-25evt-rse.fcl -S reco1-files.lst
process_name: FilterEventID

services: {}

source:
{
  module_type: RootInput
  maxEvents:  -1
}

outputs:
{
 out1:
 {
   module_type: RootOutput
   fileName:    "/exp/sbnd/data/users/yuhw/wcp-porting-img/sbnd/img-clus-matching-eval/prabhjot-100file-Aug5-debug-25evt/debug-25evt-reco1.root"
   dataTier:    "filtered"
   SelectEvents: [ filter ]
 }
}

physics:
{
  filters:
  {
    filtereventid: {
      module_type: FilterEventID
      filterevts: [ 14, 16, 39, 22, 30, 4, 2, 5, 21, 17, 31, 22, 44, 8, 14, 28, 23, 12, 31, 10, 41, 12, 34, 34, 25 ]
      filterruns: [ 44, 890, 890, 541, 272, 827, 105, 105, 105, 36, 60, 966, 710, 411, 993, 304, 492, 707, 146, 921, 921, 651, 651, 445, 658 ]
    }
  }

  filter: [ filtereventid ]
  stream1:  [ out1 ]
  trigger_paths: [ filter ]
  end_paths:     [ stream1 ]
}
