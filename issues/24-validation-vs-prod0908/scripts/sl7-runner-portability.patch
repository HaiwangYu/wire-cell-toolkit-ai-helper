 # Reap one finished background job; update BATCH_OK / BATCH_FAIL.
 # Requires bash >= 5.1 for 'wait -n -p VARNAME'.
 _batch_reap_one() {
+    # PORTABILITY FIX (scratch copy).  Upstream uses `wait -n -p VARNAME`, which
+    # needs bash >= 5.1 (`wait -n` alone needs 4.3).  The FNAL SL7 apptainer this
+    # runs in has bash 4.2.46, where BOTH are absent: `_pid` was never assigned
+    # and `set -u` aborted the batch at the first reap
+    # ("_runlib.sh: line 179: _pid: unbound variable").
+    #
+    # Reap by BLOCKING on every outstanding pid instead of on the next one to
+    # finish.  That converts streaming scheduling into wave scheduling: a slot
+    # frees only when the whole wave is done.  Accounting is unchanged, so
+    # BATCH_OK / BATCH_FAIL / BATCH_FAIL_LIST stay exactly as upstream computes
+    # them.  Cost is idle cores at the tail of each wave, which for a 19-event
+    # arm at PR_JOBS=8 is 3 waves -- acceptable, and it keeps the comparison
+    # itself bit-for-bit unaffected (each event still runs in its own process
+    # with identical arguments).
     local _pid _st
-    wait -n -p _pid 2>/dev/null && _st=0 || _st=$?
-    if [ "$_st" -eq 0 ]; then
-        BATCH_OK=$((BATCH_OK + 1))
-    else
-        BATCH_FAIL=$((BATCH_FAIL + 1))
-        BATCH_FAIL_LIST+=("${BATCH_PIDS[$_pid]:-pid:$_pid}")
-    fi
-    unset "BATCH_PIDS[$_pid]"
+    for _pid in ${BATCH_PIDS[@]+"${!BATCH_PIDS[@]}"}; do
+        wait "$_pid" && _st=0 || _st=$?
+        if [ "$_st" -eq 0 ]; then
+            BATCH_OK=$((BATCH_OK + 1))
+        else
+            BATCH_FAIL=$((BATCH_FAIL + 1))
+            BATCH_FAIL_LIST+=("${BATCH_PIDS[$_pid]:-pid:$_pid}")
+        fi
+        unset "BATCH_PIDS[$_pid]"
+    done
 }
 
