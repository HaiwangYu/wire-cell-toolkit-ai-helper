#!/bin/bash
#PBS -N wct-polaris-probe3
#PBS -A neutrinoGPU::debug
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=00:55:00
#PBS -l filesystems=home:eagle:grand
#PBS -j oe
#PBS -o /lus/eagle/projects/neutrinoGPU/yuhw/polaris-probe/probe3.out
set -u
unset LD_PRELOAD
export HTTP_PROXY=http://proxy.alcf.anl.gov:3128 HTTPS_PROXY=http://proxy.alcf.anl.gov:3128 http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
echo "=== START $(date) on $(hostname)"
echo "=== module load apptainer/1.4.1"; module use /soft/modulefiles; module load spack-pe-base 2>&1 | tail -1; module load apptainer/1.4.1 2>&1 | tail -2; which apptainer && apptainer --version
echo "=== pick binary+mode"
CANDS="$(which apptainer 2>/dev/null) /soft/spack/base/0.8.1/install/linux-sles15-x86_64/gcc-12.3.0/apptainer-1.3.2-o4dxrioaegfbzftm2uzazrkn6tprrang/bin/apptainer /soft/spack/testing/0.8.1/apptainer/install/linux-sles15-zen3/gcc-12.3.0/apptainer-1.3.6-7czfylw7oeizgfklnroabhww7kygmtjt/bin/apptainer"
APP=""; MODE=""
for c in $CANDS; do [ -x "$c" ] || continue; for m in "--userns" "--fakeroot" ""; do
  if timeout 120 $c exec $m -B /lus/eagle /lus/grand/projects/neutrinoGPU/software/containers/slf7.sif cat /etc/redhat-release >/tmp/try.out 2>&1; then echo "OK: $c $m -> $(cat /tmp/try.out)"; [ -n "$APP" ] || { APP=$c; MODE=$m; }; else echo "FAIL: $c $m -> $(tail -1 /tmp/try.out)"; fi
done; done
echo "SELECTED: APP=$APP MODE='$MODE'"; [ -n "$APP" ] || exit 1
export APPTAINER_CACHEDIR=/local/scratch/apptainer-cache APPTAINER_TMPDIR=/local/scratch/apptainer-tmp; mkdir -p $APPTAINER_CACHEDIR $APPTAINER_TMPDIR
RECO1=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/sample_generation_port/reference/extracted/02_workflow_test/test/output/prodgenie_bnb_nu_cosmic_sbnd_GenieGen-20260104T000516_G4-20260104T003738_74082e81-457f-4799-9688-74013c58255b_DetSim-20260104T190953_DecoReco_CellTreeAPA0-20260105T001812.root
echo "=== RECIPE A: eventdump 1 event via slf7.sif + overlays ($MODE)"
IMG=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images; WA=/local/scratch/larA; mkdir -p $WA
( time $APP exec $MODE --bind /lus/eagle --bind /lus/grand --bind /local/scratch --overlay $IMG/larsoft-v10_14_02.squashfs:ro --overlay $IMG/sbnd-v10_14_02_05_delta.squashfs:ro /lus/grand/projects/neutrinoGPU/software/containers/slf7.sif \
   bash -c "source /lus/eagle/projects/neutrinoGPU/larsoft_hpc/envs/sbndcode-v10_14_02_05.env; cd $WA; time lar -c eventdump.fcl -s $RECO1 -n 1 > dump.log 2>&1; echo lar_rc=\$?; grep -cE 'recob::Wire|SimEnergyDeposit' dump.log; grep -E 'recob::Wire|sim::SimEnergyDeposit' dump.log | head -6; tail -2 dump.log; echo RECIPE_A_DUMP_DONE" ) 2>&1 | tail -14
echo "=== RECIPE B: cvmfsexec (proxy) + fnal-wn-sl7 + setup sbndcode v10_14_02_0602 + eventdump ($MODE)"
cd /lus/eagle/projects/neutrinoGPU/yuhw/cvmfsexec
export CVMFS_CACHE_BASE=/local/scratch/cvmfs-cache; mkdir -p $CVMFS_CACHE_BASE
WB=/local/scratch/larB; mkdir -p $WB
( time timeout 2400 ./cvmfsexec sbnd.opensciencegrid.org sbn.opensciencegrid.org larsoft.opensciencegrid.org fermilab.opensciencegrid.org singularity.opensciencegrid.org -- bash -c "
  time $APP exec $MODE -B /cvmfs -B /lus/eagle -B /local/scratch /cvmfs/singularity.opensciencegrid.org/fermilab/fnal-wn-sl7:latest bash -c '
    cat /etc/redhat-release
    time { source /cvmfs/sbnd.opensciencegrid.org/products/sbnd/setup_sbnd.sh >/dev/null 2>&1; echo setup_sbnd_rc=\$?; }
    time { setup sbndcode v10_14_02_0602 -q e26:prof >/dev/null 2>&1; echo setup_sbndcode_rc=\$? SBNDCODE_DIR=\$SBNDCODE_DIR; }
    setup spdlog v1_14_1 -q e26:prof; echo SPDLOG_FQ_DIR=\$SPDLOG_FQ_DIR
    which lar; time lar --version 2>&1 | tail -1
    cd $WB; time lar -c eventdump.fcl -s $RECO1 -n 1 > dump.log 2>&1; echo lar_rc=\$?; grep -E \"recob::Wire|sim::SimEnergyDeposit\" dump.log | head -6; tail -2 dump.log
    echo \"--- warm second lar --version:\"; time lar --version 2>&1 | tail -1
    echo RECIPE_B_DONE'
") 2>&1 | grep -v -E "^ln: |CernVM-FS: (loading|mounted)" | tail -40
echo "=== cvmfs cache size"; du -sh $CVMFS_CACHE_BASE 2>/dev/null
echo "=== END $(date)"
