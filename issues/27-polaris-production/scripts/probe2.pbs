#!/bin/bash
#PBS -N wct-polaris-probe2
#PBS -A neutrinoGPU::debug
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=00:45:00
#PBS -l filesystems=home:eagle:grand
#PBS -j oe
#PBS -o /lus/eagle/projects/neutrinoGPU/yuhw/polaris-probe/probe2.out
set -u
export HTTP_PROXY=http://proxy.alcf.anl.gov:3128 HTTPS_PROXY=http://proxy.alcf.anl.gov:3128 http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
echo "=== START $(date) on $(hostname)"
echo "=== module search"; module use /soft/modulefiles; module -t avail 2>&1 | grep -i apptainer; module spider apptainer 2>&1 | grep -E "apptainer|module load" | head -6
echo "=== candidate binaries"
CANDS="/soft/spack/testing/0.8.1/apptainer/install/linux-sles15-zen3/gcc-12.3.0/apptainer-1.3.6-7czfylw7oeizgfklnroabhww7kygmtjt/bin/apptainer /soft/spack/base/0.8.1/install/linux-sles15-x86_64/gcc-12.3.0/apptainer-1.3.2-o4dxrioaegfbzftm2uzazrkn6tprrang/bin/apptainer /soft/spack/testing/0.8.1/apptainer/install/linux-sles15-zen3/gcc-12.3.0/apptainer-git.6ae1a25f2e4efca0d5fbba3e05c4a34e7f8f3567_1.4.0-rc.1-git.24-en46xbezlyor46aqmobuwztu2pgxddjt/bin/apptainer"
APP=""; for c in $CANDS; do for m in "" "--userns"; do echo "-- try $c $m"; if timeout 120 $c exec $m -B /lus/eagle /lus/grand/projects/neutrinoGPU/software/containers/slf7.sif cat /etc/redhat-release 2>&1 | tail -2; then APP="$c"; MODE="$m"; break 2; fi; done; done
echo "SELECTED: APP=$APP MODE=$MODE"; [ -n "$APP" ] || { echo "no working apptainer"; exit 1; }
export APPTAINER_CACHEDIR=/local/scratch/apptainer-cache APPTAINER_TMPDIR=/local/scratch/apptainer-tmp; mkdir -p $APPTAINER_CACHEDIR $APPTAINER_TMPDIR
echo "=== RECIPE A: slf7.sif + larsoft_hpc squashfs overlays"
IMG=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images
for fr in "--fakeroot" ""; do echo "-- overlay mode: '$fr' $MODE"
( time $APP exec $fr $MODE --bind /lus/eagle --bind /lus/grand --bind /local/scratch \
   --overlay $IMG/larsoft-v10_14_02.squashfs:ro --overlay $IMG/sbnd-v10_14_02_05_delta.squashfs:ro \
   /lus/grand/projects/neutrinoGPU/software/containers/slf7.sif \
   bash -c 'cat /etc/redhat-release; ldd --version | head -1; source /lus/eagle/projects/neutrinoGPU/larsoft_hpc/envs/sbndcode-v10_14_02_05.env; echo SBNDCODE_DIR=$SBNDCODE_DIR; echo WIRECELL_VERSION=$WIRECELL_VERSION LARWIRECELL_VERSION=$LARWIRECELL_VERSION SPDLOG_VERSION=$SPDLOG_VERSION; which lar && lar --version && echo RECIPE_A_OK' ) 2>&1 | tail -8 && break
done
echo "=== RECIPE B: cvmfsexec (proxy) + fnal-wn-sl7 from cvmfs + UPS sbndcode; eventdump 1 event of official MCP2025B reco1"
cd /lus/eagle/projects/neutrinoGPU/yuhw/cvmfsexec
export CVMFS_CACHE_BASE=/local/scratch/cvmfs-cache; mkdir -p $CVMFS_CACHE_BASE
RECO1=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/sample_generation_port/reference/extracted/02_workflow_test/test/output/prodgenie_bnb_nu_cosmic_sbnd_GenieGen-20260104T000516_G4-20260104T003738_74082e81-457f-4799-9688-74013c58255b_DetSim-20260104T190953_DecoReco_CellTreeAPA0-20260105T001812.root
W=/local/scratch/lar-work; mkdir -p $W
( time timeout 1500 ./cvmfsexec sbnd.opensciencegrid.org sbn.opensciencegrid.org sbn.osgstorage.org larsoft.opensciencegrid.org fermilab.opensciencegrid.org singularity.opensciencegrid.org -- bash -c "
  time $APP exec $MODE -B /cvmfs -B /lus/eagle -B /local/scratch /cvmfs/singularity.opensciencegrid.org/fermilab/fnal-wn-sl7:latest bash -c '
    cat /etc/redhat-release; bash --version | head -1; python3 --version 2>&1
    source /cvmfs/sbnd.opensciencegrid.org/products/sbnd/setup_sbnd.sh >/dev/null 2>&1; echo setup_sbnd_rc=\$?
    setup sbndcode v10_14_02_0602 -q e26:prof >/dev/null 2>&1; echo setup_sbndcode_rc=\$? SBNDCODE_DIR=\$SBNDCODE_DIR
    setup spdlog v1_14_1 -q e26:prof; echo SPDLOG_FQ_DIR=\$SPDLOG_FQ_DIR
    which lar; time lar --version 2>&1 | tail -1
    cd $W && time lar -c eventdump.fcl -s $RECO1 -n 1 2>&1 | grep -E \"recob::Wire|SimEnergyDeposit|OpFlash|Begin processing|Art has completed|ERROR|exception\" | head -20
    echo RECIPE_B_OK'
") 2>&1 | grep -v -E "^ln: |CernVM-FS: (loading|mounted)" | tail -40
echo "=== cvmfs cache size"; du -sh $CVMFS_CACHE_BASE 2>/dev/null
echo "=== END $(date)"
