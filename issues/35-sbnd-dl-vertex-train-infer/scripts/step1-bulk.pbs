#!/bin/bash
#PBS -N wct-step1-bulk
#PBS -A neutrinoGPU::debug2
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=00:59:00
#PBS -l filesystems=flare:home
#PBS -j oe
#PBS -o /lus/flare/projects/neutrinoGPU/yuhw/aurora-build-logs/step1-bulk.out
# Step 1 of the SBND 2-step chain (imaging + clustering + Q/L matching + all-APA clustering +
# truth; stops after matching) over MANY reco1 files on one node: one `lar` process per input
# file, all files of the manifest concurrently, each pinned to CORES cores (issue 35 M4).
#
#   qsub -v "MANIFEST=<tsv: path<TAB>nevents>,RUN=<run dir>[,FCL=wcls-img-clus-matching.fcl][,CORES=2][,MAXPAR=100]" step1-bulk.pbs
#
# Layout:  $RUN/f<NNN>/{qlpctree.tar.gz, mabc.zip, nugraph.h5, lar.log, time.txt, errors.log}
#          $RUN/inputs.tsv      index  nevents  file           (the input list, as run)
#          $RUN/resources.tsv   index  nevents  rc  wall_s  cpu_s  maxrss_MB  tar_MB  bee_MB  h5_MB
#          $RUN/resources.md    the summary: queue wait, node wall, per-event CPU, sizes
set -u
Y=/lus/flare/projects/neutrinoGPU/yuhw
S29=$Y/wire-cell-toolkit-ai-helper/issues/29-aurora-production/scripts
MANIFEST=${MANIFEST:?}; RUN=${RUN:?}; FCL=${FCL:-wcls-img-clus-matching.fcl}; CORES=${CORES:-2}; MAXPAR=${MAXPAR:-100}
mkdir -p $RUN
export Y SL7_IMAGE=${SL7_IMAGE:-} APPTAINER_MODE=${APPTAINER_MODE:-}; [ -n "$SL7_IMAGE" ] || unset SL7_IMAGE
J=${PBS_JOBID%%.*}
T_START=$(date +%s)
# queue wait: PBS records the submit time (qtime) and the start time (stime) of this job
QT=$(qstat -f $PBS_JOBID 2>/dev/null | awk -F' = ' '/qtime/ {print $2}'); ST=$(qstat -f $PBS_JOBID 2>/dev/null | awk -F' = ' '/stime/ {print $2}')
echo "=== START $(date) job $J node $(hostname) RUN=$RUN FCL=$FCL CORES=$CORES"
echo "queued: $QT   started: $ST"
echo "WCT=$(git -C $Y/wire-cell-toolkit rev-parse --short HEAD) ($(git -C $Y/wire-cell-toolkit branch --show-current)) LWC=$(git -C $Y/larwirecell rev-parse --short HEAD) WCP=$(git -C $Y/wcp-porting-validation rev-parse --short HEAD)"
grep -v '^#' $MANIFEST | awk -F'\t' 'NF>=2 {printf "%03d\t%s\t%s\n", NR-1, $2, $1}' > $RUN/inputs.tsv
N=$(wc -l < $RUN/inputs.tsv); NEVT=$(awk -F'\t' '{s+=$2} END {print s}' $RUN/inputs.tsv)
echo "inputs: $N files, $NEVT events (max $MAXPAR concurrent lar processes, $CORES cores each)"

SL7_SETUP=$S29/setup-aurora-run.sh $S29/in-aurora-sl7.sh bash -c "
  t0=\$(date +%s); k=0; nrun=0
  while IFS=\$'\t' read -r i n f; do
    d=$RUN/f\$i; mkdir -p \$d
    c=\$(( 1 + (k % $MAXPAR) * $CORES ))
    ( cd \$d && /usr/bin/time -v -o time.txt taskset -c \$c-\$((c+$CORES-1)) lar -n \$n -c $FCL -s \$f --no-output > lar.log 2>&1; echo \$? > rc.txt ) &
    k=\$((k+1)); nrun=\$((nrun+1))
    if [ \$nrun -ge $MAXPAR ]; then wait -n; nrun=\$((nrun-1)); fi
  done < $RUN/inputs.tsv
  wait
  echo node_wall_s=\$(( \$(date +%s) - t0 ))
" 2>&1 | grep -v '^INFO'

echo "=== resources"
printf "index\tnevents\trc\twall_s\tcpu_s\tmaxrss_MB\ttar_MB\tbee_MB\th5_MB\n" > $RUN/resources.tsv
while IFS=$'\t' read -r i n f; do
  d=$RUN/f$i; t=$d/time.txt
  wall=$(awk -F': ' '/Elapsed/ {split($2,a,":"); if (length(a)==3) print a[1]*3600+a[2]*60+a[3]; else print a[1]*60+a[2]}' $t 2>/dev/null)
  cpu=$(awk -F': ' '/User time/ {u=$2} /System time/ {s=$2} END {print u+s}' $t 2>/dev/null)
  rss=$(awk -F': ' '/Maximum resident/ {printf "%.0f", $2/1024}' $t 2>/dev/null)
  mb() { [ -f "$1" ] && stat -c %s "$1" | awk '{printf "%.1f", $1/1e6}' || echo 0; }
  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$i" "$n" "$(cat $d/rc.txt 2>/dev/null)" "${wall:-}" "${cpu:-}" "${rss:-}" "$(mb $d/qlpctree.tar.gz)" "$(mb $d/mabc.zip)" "$(mb $d/nugraph.h5)" >> $RUN/resources.tsv
done < $RUN/inputs.tsv
python3 - $RUN $QT $ST $(( $(date +%s) - T_START )) <<'PY' | tee $RUN/resources.md
import sys, csv, datetime
R, qt, st, job_s = sys.argv[1], ' '.join(sys.argv[2:5]), ' '.join(sys.argv[5:8]), int(sys.argv[8])
rows = list(csv.DictReader(open(R + '/resources.tsv'), delimiter='\t'))
ok = [r for r in rows if r['rc'] == '0']
f = lambda k: [float(r[k]) for r in ok if r[k] not in ('', None)]
nev = sum(int(r['nevents']) for r in ok)
def parse(s):
    try: return datetime.datetime.strptime(s, '%a %b %d %H:%M:%S %Y')
    except Exception: return None
qd, sd = parse(qt), parse(st)
wait = (sd - qd).total_seconds() if qd and sd else None
print('# step-1 bulk run resources: %s' % R)
print('- files: %d run, %d ok (rc=0), %d failed; events: %d' % (len(rows), len(ok), len(rows) - len(ok), nev))
print('- queue wait: %s (queued %s, started %s)' % ('%.0f s' % wait if wait is not None else 'n/a', qt, st))
print('- job wall (node): %d s = %.1f min' % (job_s, job_s / 60))
if ok:
    print('- per lar process: wall median %.0f s, max %.0f s; CPU median %.0f s; max RSS median %.0f MB, max %.0f MB'
          % (sorted(f('wall_s'))[len(ok)//2], max(f('wall_s')), sorted(f('cpu_s'))[len(ok)//2], sorted(f('maxrss_MB'))[len(ok)//2], max(f('maxrss_MB'))))
    print('- CPU per event: %.1f s (sum of user+sys over all processes / events)' % (sum(f('cpu_s')) / nev))
    print('- output per event: qlpctree.tar.gz %.2f MB, mabc.zip %.2f MB, nugraph.h5 %.2f MB; totals %.2f / %.2f / %.2f GB'
          % (sum(f('tar_MB')) / nev, sum(f('bee_MB')) / nev, sum(f('h5_MB')) / nev, sum(f('tar_MB')) / 1e3, sum(f('bee_MB')) / 1e3, sum(f('h5_MB')) / 1e3))
bad = [r['index'] for r in rows if r['rc'] != '0']
if bad: print('- FAILED indices: %s' % ' '.join(bad))
PY
echo "=== END $(date)"
