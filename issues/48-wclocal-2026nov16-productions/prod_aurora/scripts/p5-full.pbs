#!/bin/bash
#PBS -N wcl1116-p5
#PBS -A neutrinoGPU::WireCell_aurora
#PBS -q capacity
#PBS -l select=8
#PBS -l walltime=06:00:00
#PBS -l filesystems=flare:home
#PBS -j oe
#PBS -o /lus/flare/projects/neutrinoGPU/yuhw/production-prep/WCLocal2026Nov16/logs/p5.out
# ai-helper #48 P5 (Aurora): one sample (qsub -v SAMPLE=bnb|nuecc|ncdr), 8 nodes, hardlink-seeded full/<sample>/node<k>,
# step 2 only, two passes, two-tree merge.  Submit with -o logs/p5-<sample>.out.
# Runs the branch's pbs/run-pairs-capacity.pbs with the WCLocal2026Nov16 knobs.  Resume: resubmit unchanged.
set -u
Y=/lus/flare/projects/neutrinoGPU/yuhw
W=$Y/production-prep/WCLocal2026Nov16
export REPO=$Y/swp-wclocal/aurora PAIRS=$W/full/${SAMPLE:?}-pairs.tsv WORK=$W/full/$SAMPLE
export SCHEMA=$REPO/schema/recTreeWireCell-dlvtx-space.schema.json
export WC_SL7_SETUP=$REPO/env/aurora/setup-aurora-wclocal-nov16.sh
export WC_OPT=$Y/opt-0.38.0 WC_WCT_SRC=$Y/wct-0.38.0 GODEBUG=asyncpreemptoff=1
export WC_STEP2_PASSES="pr:dv2_split_move:space:recTreeWireCell-dlvtx-space.schema.json pr-dv2snap:dv2_snap:nospace:recTreeWireCell.schema.json"
export WC_DV2_BUNDLE=dv2max/sbnd/aurora_space/bundle.json
export WC_STEP1_SEEDED=1 WC_KEEP=semiprod WC_MAXPAR=100 WC_TRUST_EVENTS=1
unset LD_PRELOAD
echo "=== START $(/bin/date -u) job ${PBS_JOBID:-}; toolkit $(git -C $WC_WCT_SRC rev-parse --short HEAD); workflow $(git -C $REPO rev-parse --short HEAD)"
bash $REPO/pbs/run-pairs-capacity.pbs
echo "=== END $(/bin/date -u)"
